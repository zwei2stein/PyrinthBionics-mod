<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef ParentName="PyrinthBionics_LimbHediffBase">
        <defName>PyrinthBionics_PyrinthArm</defName>
        <label>pyrinth arm</label>
        <labelNoun>a pyrinth arm</labelNoun>
        <description>A bionic arm powered by Pyrinth crystals. It can unleash stored heat to cauterize wounds.</description>
        <descriptionHyperlinks>
            <ThingDef>PyrinthBionics_PyrinthArmItem</ThingDef>
        </descriptionHyperlinks>
        <comps>
            <li Class="HediffCompProperties_VerbGiver">
                <tools>
                    <li>
                        <label>fist</label>
                        <capacities>
                            <li>Blunt</li>
                        </capacities>
                        <power>12</power>
                        <cooldownTime>2</cooldownTime>
                        <soundMeleeHit>MeleeHit_BionicPunch</soundMeleeHit>
                        <soundMeleeMiss>MeleeMiss_BionicPunch</soundMeleeMiss>
                    </li>
                </tools>
            </li>
        </comps>
        <spawnThingOnRemoved>PyrinthBionics_PyrinthArmItem</spawnThingOnRemoved>
        <abilities>
            <li>PyrinthBionics_CauterizeAbility</li>
        </abilities>
        <modExtensions>
            <li Class="PyrinthBionics.PyrinthBionicsImplantExtension">
                <heatCapacity>10</heatCapacity>
                <heatPerSecond>0.5</heatPerSecond>
            </li>
        </modExtensions>
    </HediffDef>

</Defs>
