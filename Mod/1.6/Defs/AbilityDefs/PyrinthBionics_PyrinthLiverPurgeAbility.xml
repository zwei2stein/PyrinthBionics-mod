                    <li MayRequire="BiomesTeam.BiomesCaverns">BMT_PurpleLung</li>
                    <li MayRequire="BiomesTeam.BiomesCaverns">BMT_SporeFlesh</li>
                    <li MayRequire="SirMashedPotato.Ashlands">Mashed_Ashlands_SwampFever</li>
