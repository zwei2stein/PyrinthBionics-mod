                    <li MayRequire="vanillaquestsexpanded.cryptoforge">VQE_CryptoSlowdown</li>
                    <li MayRequire="BiomesTeam.BiomesCore">BMT_Paralysis</li>
                    <li MayRequire="BiomesTeam.BiomesCaverns">BMT_SporesBuildup</li>
