        <comps>
            <li Class="PyrinthBionics.CompProperties_AbilityImplantJump">
                <heatCost>50</heatCost>
            </li>
            <li Class="CompProperties_AbilityRequiresCapacity">
                <capacity>Manipulation</capacity>
            </li>
        </comps>
    </AbilityDef>

</Defs>
